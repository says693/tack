{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tack",
  "version": "0.1.0",
  "identifier": "app.tack.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "hud",
        "title": "tack",
        "url": "hud.html",
        "width": 180,
        "height": 40,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": true
      },
      {
        "label": "main",
        "title": "tack",
        "url": "main.html",
        "width": 440,
        "height": 712,
        "minWidth": 400,
        "minHeight": 560,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "center": true,
        "visible": false
      },
      {
        "label": "anchor",
        "title": "tack · 锚点",
        "url": "anchor.html",
        "width": 272,
        "height": 440,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "copyright": "MIT · tack contributors",
    "shortDescription": "A knowledge pinboard at the edge of your screen.",
    "longDescription": "tack 把随手选中的几句话钉成卡片，每天温和地提醒你复习，答错时告诉你错在哪。",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp"
      }
    }
  }
}
